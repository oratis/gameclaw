generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  provider      String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  gameAccounts  GameAccount[]
  checkinLogs   CheckInLog[]
  tasks         Task[]
  taskTemplates TaskTemplate[]
  subscription  Subscription?
  usageMeters   UsageMeter[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GameAccount {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  uid         String
  nickname    String?
  server      String?
  // Legacy HoYoLab-only credentials. New accounts write to `credentials`
  // instead. Kept nullable for backward compatibility with existing rows.
  ltokenV2    String?
  ltuidV2     String?
  cookieToken String?
  // Encrypted JSON blob of adapter-specific credentials. Shape is determined
  // by the adapter's credentialFields. Reading: see src/lib/credentials.ts.
  credentials String?
  autoCheckin Boolean  @default(true)
  isActive    Boolean  @default(true)
  /// Set by the health cron when recent tasks show credential-expiry / auth
  /// failures. Dashboard renders a banner; runTask still allows attempts so
  /// the user can verify a re-link succeeded.
  needsRelink Boolean  @default(false)
  lastCheckin DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkinLogs CheckInLog[]
  tasks       Task[]

  @@unique([userId, gameId, uid])
  @@index([userId])
  @@index([gameId])
}

model CheckInLog {
  id            String   @id @default(cuid())
  gameAccountId String
  userId        String
  gameId        String
  status        String
  reward        String?
  errorMessage  String?
  triggeredBy   String
  createdAt     DateTime @default(now())

  gameAccount GameAccount @relation(fields: [gameAccountId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gameAccountId, createdAt])
}

model SupportedGame {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  actId       String
  apiBase     String
  iconUrl     String?
  description String?
  isActive    Boolean @default(true)
}

// Generic representation of "one thing the AI did (or will do) on the user's behalf".
// Replaces CheckInLog over time — `checkin` is just one of many capabilities.
// CheckInLog is still written for backwards compat in M2; will be removed in M3.
model Task {
  id              String    @id @default(cuid())
  userId          String
  gameAccountId   String?
  /// Groups all tasks fired from a single template execution.
  templateRunId   String?
  templateStepIdx Int?
  /// e.g. "checkin" | "mail_claim" | "stamina_spend_dispatch"
  capability      String
  /// e.g. "genshin" | "wuwa" | "arknights"
  gameSlug        String
  /// pending | scheduled | running | success | already_done | failed | skipped
  status          String
  /// "L1" | "L2" | "L3" — backend tier that handled this task
  backendTier     String?
  /// FK to Worker (nullable, only L3 tasks)
  workerId        String?
  scheduledFor    DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  /// Self-FK for retry chains
  retryOf         String?
  /// "cron" | "manual" | "skill" | "agent" | "template"
  triggeredBy     String
  /// capability-specific input (e.g. {roleId})
  payload         Json?
  /// capability-specific output (e.g. {reward, streak})
  result          Json?
  /// {tokensIn, tokensOut, ms, usd, gpuSeconds?}
  cost            Json?
  errorCode       String?
  errorMessage    String?
  /// GCS / S3 URLs for L3 verification screenshots
  screenshotUrls  String[]
  createdAt       DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameAccount GameAccount? @relation(fields: [gameAccountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, scheduledFor])
  @@index([templateRunId])
  @@index([gameAccountId])
}

/// User-defined "daily routine" — an ordered list of (capability, game, params)
/// optionally fired on a cron schedule.
model TaskTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  /// Optional cron expression (e.g. "0 4 * * *")
  schedule    String?
  /// Ordered array of TaskStep records: [{gameSlug, capability, params?, when?}]
  steps       Json
  /// {staminaThreshold:8, weeklyOnSundayBefore:"21:00", ...}
  preferences Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Billing / quota state per user.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  /// "free" | "pro" | "proplus" | "enterprise"
  tier                 String    @default("free")
  /// -1 means unlimited
  monthlyTaskQuota     Int       @default(90)
  /// AI Planner calls per month (Pro+'s primary differentiator)
  monthlyPlanCallQuota Int       @default(5)
  /// LLM spend ceiling, USD cents per month (-1 = unlimited)
  monthlyAiBudgetCents Int       @default(0)
  /// Pro+ flag — gates L3 capabilities (M3 — not yet wired)
  l3Enabled            Boolean   @default(false)
  /// PayPal subscription ID (e.g. "I-BW452GLLEP1G")
  paypalSubscriptionId String?   @unique
  /// PayPal plan ID this subscription is on (e.g. "P-5ML4271244454362WXNWU5NQ")
  paypalPlanId         String?
  /// Cached PayPal subscription status (ACTIVE | SUSPENDED | CANCELLED | EXPIRED)
  paypalStatus         String?
  startedAt            DateTime  @default(now())
  renewsAt             DateTime?
  /// "active" | "past_due" | "canceled"
  status               String    @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Per-user, per-billing-period usage counter. Increment in runTask /
/// proposePlan; query in quota enforcement.
model UsageMeter {
  id              String   @id @default(cuid())
  userId          String
  /// "YYYY-MM" UTC, e.g. "2026-05". Resets monthly.
  period          String
  taskCount       Int      @default(0)
  planCallCount   Int      @default(0)
  llmTokensIn     Int      @default(0)
  llmTokensOut   Int      @default(0)
  /// LLM cost in USD micro-dollars (× 1e6) to avoid float arithmetic.
  llmCostUsdMicro BigInt   @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period])
}

/// Append-only audit trail of PayPal webhook events we received and how we
/// processed them. Useful for debugging billing disputes.
model PayPalWebhookEvent {
  id            String   @id @default(cuid())
  /// PayPal's event ID (e.g. "WH-XXX") — used for idempotency
  paypalEventId String   @unique
  eventType     String
  /// Raw event body for replay/debugging
  rawBody       Json
  /// "received" | "processed" | "failed" | "skipped"
  status        String   @default("received")
  errorMessage  String?
  receivedAt    DateTime @default(now())
  processedAt   DateTime?

  @@index([eventType, receivedAt])
}

/// L3 worker pool registry. One row per spawned worker instance (Cloud Run
/// Jobs execution, GCE VM, etc.). Created when dispatched, updated by the
/// worker via /api/internal/worker-callback.
model Worker {
  id              String    @id @default(cuid())
  /// Worker pool key, e.g. "l3-arknights", "l3-starrail"
  pool            String
  /// Cloud Run Jobs execution name (projects/.../executions/...) or VM ID
  executionName   String?
  /// "pending" | "running" | "completed" | "failed" | "cancelled"
  status          String    @default("pending")
  currentTaskId   String?
  region          String    @default("us-central1")
  imageVersion    String?
  /// null = shared pool; user ID = dedicated worker (Pro+ feature)
  ownerUserId     String?
  totalTasksRun   Int       @default(0)
  successRate     Float?
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobs WorkerJob[]

  @@index([pool, status])
  @@index([currentTaskId])
}

/// One row per L3 dispatch: links a Task to a Worker execution and tracks
/// the lifecycle. The callbackToken authenticates the worker calling back
/// with results.
model WorkerJob {
  id             String    @id @default(cuid())
  taskId         String    @unique
  workerId       String?
  pool           String
  executionName  String?
  /// "PENDING" | "RUNNING" | "SUCCEEDED" | "FAILED" | "CANCELLED"
  executionState String    @default("PENDING")
  /// 64-char hex; one-time secret the worker uses on callback
  callbackToken  String
  /// Single-use; set to true after the worker callback succeeds
  callbackUsed   Boolean   @default(false)
  startedAt      DateTime?
  completedAt    DateTime?
  screenshotUrls String[]
  errorMessage   String?
  createdAt      DateTime  @default(now())

  worker Worker? @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([executionName])
  @@index([executionState])
}

/// Risk circuit-breaker state per vendor or per (vendor, capability) scope.
/// When a vendor's recent failure rate spikes (e.g. they changed their API),
/// we open the circuit and stop dispatching to it until manually closed or
/// a cooldown passes.
model RiskCircuitState {
  id          String    @id @default(cuid())
  /// "vendor:hoyoverse" | "adapter:wuwa" | "capability:weekly_dungeon"
  scope       String    @unique
  /// "closed" (normal) | "open" (suspended)
  state       String    @default("closed")
  failureRate Float     @default(0)
  windowStart DateTime?
  windowEnd   DateTime?
  triggeredBy String?
  resumesAt   DateTime?
  notes       String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([state])
}

/// Pre-launch demand signal collection — "what game / what task / what price".
/// Public POST; no auth needed.
model DemandSignal {
  id           String   @id @default(cuid())
  /// Optional: if user is signed in
  userId       String?
  /// Free-text email (for follow-up if user didn't sign in)
  email        String?
  /// Free-text game name as user typed it (we map post-hoc)
  gameTyped    String
  /// Mapped to canonical slug if recognized
  gameSlug     String?
  /// Free-text task description
  taskDesc     String
  /// Reported willingness to pay, USD cents per task or per month (free-text really)
  priceText    String?
  /// "task" | "monthly" — interpretation of priceText
  priceType    String?
  source       String?
  createdAt    DateTime @default(now())

  @@index([gameSlug])
  @@index([createdAt])
}
